// アプリと拡張に共通の設定(版・Bundle ID のもと・App Group)。App.xcconfig・Extension.xcconfig が読み込む。
// TestFlight に送る流れ(.github/workflows/testflight.yml)が、送る前に Signing.xcconfig(署名の設定。リポジトリには入れない)を作る。
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
// 仮の Bundle ID。利用者が決めたら、GitHub の変数 BUNDLE_ID で差し替える(拡張は、この後ろに .ShieldConfiguration などをつける)
TK_BASE_BUNDLE_ID = com.example.studyapp
// スマホ制限(決定事項 D-24)で、アプリと拡張が設定と様子を共有する場所
TK_APP_GROUP = group.$(TK_BASE_BUNDLE_ID)
// Apple の許可(Family Controls)を得て、拡張を入れたビルドか。restriction.yml を含めたときだけ YES にする
TK_RESTRICTION_ENABLED = NO

#include? "Signing.xcconfig"
