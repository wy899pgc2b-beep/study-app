# 公開リポジトリ。学習の記録や撮影から作ったデータは入れない
# (結果画面・検証モードで書き出した JSON は、ここに置かない)
*.session.json
*-export.json
exports/
recordings/

# ビルド
.build/
.swiftpm/
build/
DerivedData/
xcuserdata/
*.xcworkspace/xcuserdata/
Pods/
node_modules/

.DS_Store

# アプリの書き出し(学習の記録。入れない)
tsukuelog-*.json

# 生成するもの・取ってくるもの
ios/App/*.xcodeproj/
ios/App/*.xcworkspace/
ios/App/Generated/
ios/App/Resources/Models/
ios/App/Resources/Fonts/

# 署名の鍵と設定(GitHub の Secrets に置く。リポジトリには絶対に入れない)
ios/App/Config/Signing.xcconfig
*.p8
*.p12
*.mobileprovision
*.cer

# Python
__pycache__/
*.pyc

# アイコンを作るときに取ってくる文字(scripts/make_icon.py)
ios/App/.icon-fonts/
